<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 悬浮窗 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 前台服务保活 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
      Android 14 起，每个前台服务都必须声明并传入一个「类型」。悬浮球不属于任何既有类型
      （不是播放、不是录屏、不是同步），所以用 specialUse 并说明用途。
      历史上这里什么都没有 → startForeground 抛 MissingForegroundServiceTypeException
      → FloatingBallService 一创建就崩溃 → 进程死 → 无障碍服务被系统记为"已崩溃"并关掉开关，
      这正是「点悬浮球没反应 / 权限被自动关闭」的真正根因。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      仅用于「修复无障碍连接」：把本应用的无障碍服务从系统设置里摘掉再装回，
      触发系统重新绑定（等价于用户在设置里手动「关→开」一次）。
      普通应用拿不到该权限，需要一次性 adb 授权：
        adb shell pm grant com.example.studentlookup android.permission.WRITE_SECURE_SETTINGS
      未授权时 canSelfRepair() 返回 false，App 会改为引导用户手动操作。
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- 申请加入省电白名单（OPPO/ColorOS 上防止 App 进程被系统清理掉） -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.StudentLookup">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 截屏权限申请（OCR 兜底用） -->
        <activity
            android:name=".ui.CapturePermissionActivity"
            android:exported="false" />

        <!-- 悬浮球服务（仅悬浮视图 + 会话查询，用 specialUse 类型） -->
        <service
            android:name=".service.FloatingBallService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="悬浮速查球：常驻一个可点击的悬浮按钮，按需读取当前微信会话标题做本地查询。" />
        </service>

        <!-- 截屏采集服务（MediaProjection） -->
        <service
            android:name=".service.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 无障碍服务：读取微信会话标题 + 前台应用感知 -->
        <service
            android:name=".service.LookupAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
